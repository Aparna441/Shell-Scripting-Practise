Approach 3 Most preferred

#!/bin/bash
###############################################
#Script to check if user exists
###############################################

echo "Enter username to validate: "
read name

if [ -z "$name" ]
then
        echo "Error: Username cannot be empty!"
        exit 1
fi

if id "$name" &>/dev/null
then
        echo "User already exists"
else
        echo "User does not exists"
fi



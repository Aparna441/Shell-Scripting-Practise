3 ways to write a script to check if user exists using ID, getent and cat


#!/bin/bash
###############################################
#Script to check if user exists using getent
###############################################

echo "Enter username to validate: "
read name

if [ -z "$name" ]
then
        echo "Error: Username cannot be empty!"
        exit 1
fi

if getent passwd | grep -q "^$name:"
then
        echo "User already exists"
else
        echo "User does not exists"
fi



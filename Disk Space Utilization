#!/bin/bash

#############################################################
#script for checking Disk space Utilizzation
#############################################################

THRESHOLD=80

Usage=$(df -h / | awk 'NR==2 {print $5}' | tr -d '%')

if [ "$Usage" -gt "$THRESHOLD" ]
then
        echo "WARNING: Disk usage is high"
else
        echo "Disk Usage is normal"
fi

